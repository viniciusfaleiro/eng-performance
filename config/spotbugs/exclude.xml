<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring Boot main class is intentionally a launcher shell. -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="DM_EXIT"/>
    </Match>

    <!-- Test sources are excluded from EI/security heuristics. -->
    <Match>
        <Source name="~.*[/\\]test[/\\].*"/>
    </Match>

    <!-- Constructor-injected Spring beans in the inbound web adapter are effectively
         immutable references; EI_EXPOSE_REP2 is a false positive for DI controllers. -->
    <Match>
        <Package name="~com\.engperf\.adapter\.inbound\.web.*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="EI_EXPOSE_REP"/>
        </Or>
    </Match>

    <!-- Same for the persistence adapter: injected Spring Data repositories and JPA entities. -->
    <Match>
        <Package name="~com\.engperf\.adapter\.outbound\.persistence.*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="EI_EXPOSE_REP"/>
        </Or>
    </Match>
</FindBugsFilter>
